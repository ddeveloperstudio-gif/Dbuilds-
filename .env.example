# ==============================================================================
# DBUILDS 2.0 — PRIVATE CLIENT CRM & ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI Studio calls (Chat & Wireframe Audit).
# Injected automatically in AI Studio from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base domain URL where this website is hosted.
# Used for direct links in notification emails (e.g. https://buildbyd.com).
APP_URL="https://buildbyd.com"

# OWNER_EMAIL: The destination email address where new client enquiry alerts are sent.
# Default: professional1511new@gmail.com
OWNER_EMAIL="professional1511new@gmail.com"

# ADMIN_EMAIL: Authorized administrator email for the /admin dashboard.
# Default: professional1511new@gmail.com
ADMIN_EMAIL="professional1511new@gmail.com"

# ADMIN_PASSWORD: Private password for Dhanush to unlock the /admin dashboard.
# Change this to your own custom secure passphrase. Default for initial access: dbuilds2026
ADMIN_PASSWORD="dbuilds2026"

# RESEND_API_KEY: Transactional email provider API key from https://resend.com.
# Free tier includes 3,000 emails/month (100 emails/day).
# When this key is provided, new enquiries instantly dispatch an email alert to OWNER_EMAIL.
# If omitted or pending, enquiries are safely stored in the database with status "not_configured".
RESEND_API_KEY="re_123456789_abcdefg"

# SENDER_EMAIL: The "From" email address. For testing on Resend's free tier, use "onboarding@resend.dev".
# Once your domain buildbyd.com is verified in Resend, use "DBUILDS 2.0 <notifications@buildbyd.com>".
SENDER_EMAIL="DBUILDS 2.0 <onboarding@resend.dev>"
